rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin uploads use download-token URLs; rules mainly block anonymous listing.
    match /admin/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
