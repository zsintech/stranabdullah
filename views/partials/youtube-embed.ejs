<% const embed = typeof embedUrl !== "undefined" && embedUrl ? embedUrl : youtubeEmbedUrl(typeof videoUrl !== "undefined" ? videoUrl : ""); %>
<% const watch = typeof watchUrl !== "undefined" && watchUrl ? watchUrl : youtubeWatchUrl(typeof videoUrl !== "undefined" ? videoUrl : ""); %>
<% if (embed) { %>
<figure class="youtube-embed">
  <div class="youtube-embed__frame">
    <iframe
      src="<%= embed %>"
      title="<%= typeof embedTitle !== 'undefined' && embedTitle ? embedTitle : 'ڤیدیۆ' %>"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
  <% if (watch) { %>
  <figcaption class="youtube-embed__caption">
    <a href="<%= watch %>" class="youtube-embed__watch btn btn-secondary btn-sm" rel="noopener noreferrer" target="_blank">
      بینین لە یوتیوب ←
    </a>
  </figcaption>
  <% } %>
</figure>
<% } %>
