<header
  class="site-header site-header--atmosphere sticky top-0 z-50<%= headerOverHero ? ' site-header--over-hero' : '' %>"
  data-home="<%= onHome ? 'true' : 'false' %>"
  data-over-hero="<%= headerOverHero ? 'true' : 'false' %>"
>
  <div data-header-shell class="shell flex items-center gap-3 transition-[height,padding,gap] duration-300">
    <a href="/" class="masthead-lockup group" aria-label="نووسینگەی تایبەتی ستران عەبدوڵڵا">
      <span class="masthead-flora" aria-hidden>
        <img src="/brand/tulip.png" alt="" class="masthead-flora__bloom" />
      </span>
      <span class="masthead-brand">
        <span class="masthead-wordmark">ستران عەبدوڵڵا</span>
      </span>
    </a>

    <nav aria-label="ڕێنیشاندەری سەرەکی" class="masthead-nav">
      <% navLinks.forEach(function (link) { const active = isActivePath(path, link.href); %>
      <a
        href="<%= link.href %>"
        <% if (active) { %>aria-current="page"<% } %>
        class="masthead-link<%= active ? ' is-active' : '' %>"
      ><%= link.label %></a>
      <% }); %>
    </nav>

    <div class="masthead-tools">
      <a href="/archive" class="masthead-search">
        <%- include("search-glyph") %>
        <span class="link-underline font-semibold">گەڕان</span>
      </a>

      <button
        type="button"
        class="masthead-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only" data-menu-label>کردنەوەی مێنو</span>
        <span class="masthead-toggle__bars" aria-hidden="true">
          <span data-bar-top class="masthead-toggle__bar masthead-toggle__bar--top"></span>
          <span data-bar-bottom class="masthead-toggle__bar masthead-toggle__bar--bottom"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-nav" class="mobile-nav hidden" hidden data-menu-close>
  <nav aria-label="مێنوی مۆبایل" class="mobile-nav__panel" onclick="event.stopPropagation()">
    <div class="mobile-nav__head">
      <p class="mobile-nav__brand">ستران عەبدوڵڵا</p>
      <button type="button" class="mobile-nav__close" data-menu-close>
        <span class="sr-only">داخستنی مێنو</span>
        <span aria-hidden>×</span>
      </button>
    </div>

    <div class="mobile-nav__links">
      <% navLinks.forEach(function (link) { const active = isActivePath(path, link.href); %>
      <a
        href="<%= link.href %>"
        data-menu-close
        <% if (active) { %>aria-current="page"<% } %>
        class="mobile-nav__link<%= active ? ' is-active' : '' %>"
      >
        <% if (active) { %><span class="mobile-nav__dot" aria-hidden></span><% } %>
        <%= link.label %>
      </a>
      <% }); %>
    </div>

    <a href="/archive" class="btn btn-primary mobile-nav__search" data-menu-close>
      <%- include("search-glyph") %>
      گەڕان لە ئەرشیف
    </a>
  </nav>
</div>
