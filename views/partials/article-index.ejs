<% if (items.length) { %>
<ul class="<%= typeof columns !== 'undefined' && columns ? 'article-index article-index--cols' : 'article-index' %>">
  <% items.forEach(function (entry) { const thumb = coverOf(entry); %>
  <li>
    <a href="/archive/<%= entry.slug %>" class="article-index__row group">
      <% if (thumb) { %>
      <span class="article-index__thumb">
        <img src="<%= thumb %>" alt="" loading="lazy" decoding="async" />
      </span>
      <% } %>
      <span class="article-index__date t-meta tabular-nums"><%= formatKuNumeric(entry.publishedAt) %></span>
      <span class="article-index__copy min-w-0">
        <span class="link-underline article-index__title"><%= entry.title %></span>
        <% if (typeof excerpt !== "undefined" && excerpt && isUsefulExcerpt(entry)) { %>
        <span class="t-small mt-1 block line-clamp-2 text-ink-muted"><%= entry.summary %></span>
        <% } %>
      </span>
      <% if (!(typeof columns !== "undefined" && columns)) { %>
      <span class="article-index__meta t-meta">
        <% if (entry.language !== "ku") { %>
        <span><%= languageLabels[entry.language] %></span>
        <% } else { %>
        <span class="text-leaf-600"><%= contentTypeLabels[entry.contentType] %></span>
        <% } %>
        <span class="arrow-slide text-forest-900" aria-hidden>←</span>
      </span>
      <% } %>
    </a>
  </li>
  <% }); %>
</ul>
<% } %>
