<% if (items.length) { %>
<% const lead = items[0]; const leadCover = coverOf(lead); %>
<div class="essay-spread essay-spread--lead-only">
  <div class="essay-spread__stage">
    <article class="essay-spread__lead float-saucer float-saucer--rounded float-saucer--lift-sm">
      <% if (leadCover) { %>
      <a href="/archive/<%= lead.slug %>" class="essay-spread__lead-media" tabindex="-1" aria-hidden="true">
        <img src="<%= leadCover %>" alt="" loading="lazy" decoding="async" />
      </a>
      <% } %>
      <div class="essay-spread__lead-body">
        <%- include("item-meta", { item: lead, metaOptions: { dateStyle: "full" } }) %>
        <%- include("gold-rule", { extraClass: "mt-2 max-w-[5.5rem] opacity-70" }) %>
        <h3 class="essay-spread__lead-title">
          <a href="/archive/<%= lead.slug %>" class="link-underline text-forest-950"><%= lead.title %></a>
        </h3>
        <% if (isUsefulExcerpt(lead)) { %>
        <p class="essay-spread__lead-excerpt"><%= lead.summary %></p>
        <% } %>
        <p class="mt-3.5">
          <a href="/archive/<%= lead.slug %>" class="t-meta inline-flex items-center gap-2 font-semibold text-forest-900 no-underline">
            <span class="link-underline">زیاتر بخوێنەوە</span>
            <span class="arrow-slide" aria-hidden>←</span>
          </a>
        </p>
      </div>
    </article>
  </div>
</div>
<% } %>
