<% if (items.length) { %>
<% const lead = items[0]; const rest = items.slice(1); const supporting = rest.slice(0, 2); const more = rest.slice(2); %>
<div class="essay-spread">
  <div class="essay-spread__stage">
    <article class="essay-spread__lead float-saucer float-saucer--rounded float-saucer--lift-sm">
      <% if (lead.year) { %>
      <p class="essay-spread__rail" aria-hidden><%= kuDigits(lead.year) %></p>
      <% } %>
      <div class="essay-spread__lead-body">
        <%- include("item-meta", { item: lead, metaOptions: { dateStyle: "numeric" } }) %>
        <%- include("gold-rule", { extraClass: "mt-2 max-w-[5.5rem] opacity-70" }) %>
        <h3 class="essay-spread__lead-title">
          <a href="/archive/<%= lead.slug %>" class="link-underline text-forest-950"><%= lead.title %></a>
        </h3>
        <% if (isUsefulExcerpt(lead)) { %>
        <p class="essay-spread__lead-excerpt"><%= lead.summary %></p>
        <% } %>
        <p class="mt-3.5">
          <a href="/archive/<%= lead.slug %>" class="t-meta inline-flex items-center gap-2 font-semibold text-forest-900 no-underline">
            <span class="link-underline">زیاتر بخوێنەوە</span>
            <span class="arrow-slide" aria-hidden>←</span>
          </a>
        </p>
      </div>
    </article>

    <% if (supporting.length) { %>
    <div class="essay-spread__stack float-saucer float-saucer--rounded float-saucer--lift-sm">
      <% supporting.forEach(function (entry) { %>
      <article class="essay-spread__card">
        <%- include("item-meta", { item: entry, metaOptions: { dateStyle: "numeric" } }) %>
        <h3 class="essay-spread__card-title">
          <a href="/archive/<%= entry.slug %>" class="link-underline text-forest-950"><%= entry.title %></a>
        </h3>
        <% if (isUsefulExcerpt(entry)) { %>
        <p class="essay-spread__card-excerpt"><%= entry.summary %></p>
        <% } %>
      </article>
      <% }); %>
    </div>
    <% } %>
  </div>

  <% if (more.length) { %>
  <ul class="essay-spread__river float-saucer float-saucer--rounded float-saucer--lift-sm">
    <% more.forEach(function (entry) { %>
    <li>
      <a href="/archive/<%= entry.slug %>" class="essay-spread__river-link">
        <span class="essay-spread__river-title link-underline"><%= entry.title %></span>
        <% if (entry.year) { %>
        <span class="essay-spread__river-year"><%= kuDigits(entry.year) %></span>
        <% } %>
      </a>
    </li>
    <% }); %>
  </ul>
  <% } %>
</div>
<% } %>
