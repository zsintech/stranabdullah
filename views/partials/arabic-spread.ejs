<% if (items.length) { %>
<% const lead = items[0]; %>
<div class="lang-spread lang-spread--lead-only" lang="ar" dir="rtl">
  <article class="lang-spread__lead float-saucer float-saucer--rounded float-saucer--lift-sm">
    <%- include("item-meta", { item: lead, metaOptions: { dateStyle: "full", typeLabel: "عربي" } }) %>
    <h3 class="lang-spread__lead-title">
      <a href="/archive/<%= lead.slug %>" class="link-underline text-forest-950"><%= lead.title %></a>
    </h3>
    <% if (isUsefulExcerpt(lead)) { %>
    <p class="lang-spread__lead-excerpt"><%= lead.summary %></p>
    <% } %>
  </article>
</div>
<% } %>
