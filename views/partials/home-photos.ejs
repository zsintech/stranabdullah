<%
  const fromAdmin = (typeof photos !== "undefined" && photos ? photos : [])
    .map(function (item, index) {
      const src = coverOf(item);
      if (!src) return null;
      return {
        href: "/archive/" + item.slug,
        src: src,
        title: item.title,
        yearLabel: item.subtitle || (item.year ? "ساڵی " + kuDigits(item.year) : ""),
        wide: Boolean(item.extras && item.extras.homeGalleryWide) || index % 3 === 1,
      };
    })
    .filter(Boolean);

  const shots = fromAdmin.length ? fromAdmin : archivePhotoFallbacks;
%>
<%- include("photo-lane", {
  shots: shots,
  headingKicker: "ئەرشیف",
  headingTitle: "وێنە",
  laneHeadingId: "photos-heading",
  laneMoreHref: "/media",
  laneMoreLabel: "هەموو وێنەکان",
}) %>
