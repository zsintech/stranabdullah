<%
  const fromAdmin = (typeof photos !== "undefined" && photos ? photos : [])
    .map(function (item) {
      const src = coverOf(item);
      if (!src) return null;
      return {
        href: "/archive/" + item.slug,
        src: src,
        title: item.title,
        yearLabel: item.subtitle || (item.year ? "ساڵی " + kuDigits(item.year) : ""),
        wide: Boolean(item.extras && item.extras.homeGalleryWide),
      };
    })
    .filter(Boolean);

  const pool = fromAdmin.length ? fromAdmin : archivePhotoFallbacks;
  const useSpread = pool.length <= 3;
  let shots = pool;

  if (useSpread && pool.length === 3) {
    shots = [
      Object.assign({}, pool[1], { wide: false }),
      Object.assign({}, pool[0], { wide: true }),
      Object.assign({}, pool[2], { wide: false }),
    ];
  } else if (useSpread && pool.length === 2) {
    shots = [
      Object.assign({}, pool[1], { wide: false }),
      Object.assign({}, pool[0], { wide: true }),
    ];
  } else if (useSpread && pool.length === 1) {
    shots = [Object.assign({}, pool[0], { wide: true })];
  } else {
    shots = pool.map(function (shot, index) {
      return Object.assign({}, shot, { wide: shot.wide || index % 3 === 1 });
    });
  }
%>
<%- include("photo-lane", {
  shots: shots,
  forceSpread: useSpread,
  laneMod: " photo-lane--home",
  headingKicker: "ئەرشیف",
  headingTitle: "وێنە",
  laneHeadingId: "photos-heading",
  laneMoreHref: "/media",
  laneMoreLabel: "هەموو وێنەکان",
}) %>
