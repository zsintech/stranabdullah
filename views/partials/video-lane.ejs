<%
  var lane = typeof locals === "object" && locals ? locals : {};
  var entries = Array.isArray(lane.entries) ? lane.entries : [];
  var kicker = lane.headingKicker || "یوتیوب";
  var title = lane.headingTitle || "ڤیدیۆ";
  var headingId = lane.laneHeadingId || "video-lane-heading";
  var playlistUrl = lane.playlistUrl || "";
  var playlistLabel = lane.playlistLabel || "لیستی یوتیوب";
  var allowEmpty = Boolean(lane.showEmpty);
  var emptyCopy = lane.emptyNote || "لینکی یوتیوب لە بەڕێوەبەر دابنێ.";
  var extraClass = lane.laneMod ? (" " + lane.laneMod.trim()) : "";
  var isSpread = entries.length > 0 && entries.length <= 3;
  function frameVariant(index, total) {
    if (total === 3 && index === 1) return "wide";
    if (total !== 3 && index % 3 === 1) return "wide";
    return "tall";
  }
%>
<section class="video-lane<%= extraClass %><%= isSpread ? " video-lane--spread" : "" %><%= entries.length ? "" : " video-lane--empty" %>" aria-labelledby="<%= headingId %>" data-video-lane>
  <div class="site-container">
    <header class="video-lane__head">
      <div class="video-lane__intro">
        <p class="video-lane__kicker"><%= kicker %></p>
        <h2 id="<%= headingId %>" class="video-lane__title"><%= title %></h2>
      </div>
      <% if (playlistUrl && entries.length) { %>
      <a href="<%= playlistUrl %>" class="video-lane__all group" rel="noopener noreferrer" target="_blank">
        <span class="link-underline"><%= playlistLabel %></span>
        <span class="arrow-slide" aria-hidden="true">←</span>
      </a>
      <% } %>
    </header>
  </div>

  <% if (entries.length) { %>
  <div class="video-lane__viewport">
    <% if (!isSpread) { %>
    <button type="button" class="video-lane__nav video-lane__nav--prev" data-video-prev aria-label="ڤیدیۆی پێشوو">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" class="video-lane__nav video-lane__nav--next" data-video-next aria-label="ڤیدیۆی دواتر">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <div class="video-lane__fade video-lane__fade--start" aria-hidden="true"></div>
    <div class="video-lane__fade video-lane__fade--end" aria-hidden="true"></div>
    <% } %>
    <div class="video-lane__track" dir="rtl" data-video-track tabindex="0" aria-label="<%= title %>">
      <% entries.forEach(function (entry, index) {
        var variant = frameVariant(index, entries.length);
      %>
      <article class="video-lane__frame video-lane__frame--<%= variant %>" style="--i: <%= index %>">
        <div class="video-lane__media">
          <button
            type="button"
            class="video-lane__play"
            data-video-play
            data-embed-url="<%= entry.embedUrl %>"
            data-watch-url="<%= entry.watchUrl %>"
            aria-label="لێدانی <%= entry.title %>"
          >
            <img
              src="<%= entry.thumbUrl %>"
              alt=""
              loading="<%= index < 2 ? 'eager' : 'lazy' %>"
              decoding="async"
              class="video-lane__thumb"
            />
            <span class="video-lane__play-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M9 6.5v11l9-5.5-9-5.5Z" fill="currentColor" /></svg>
            </span>
          </button>
          <div class="video-lane__embed" hidden data-video-frame></div>
          <span class="video-lane__caption">
            <span class="video-lane__index"><%= kuDigits(index + 1) %></span>
            <span class="video-lane__caption-copy">
              <span class="video-lane__caption-title"><%= entry.title %></span>
              <% if (entry.yearLabel) { %>
              <span class="video-lane__year"><%= entry.yearLabel %></span>
              <% } %>
            </span>
          </span>
        </div>
      </article>
      <% }); %>
    </div>
  </div>
  <% } else if (allowEmpty) { %>
  <div class="site-container">
    <p class="video-lane__empty"><%= emptyCopy %></p>
  </div>
  <% } %>
</section>
