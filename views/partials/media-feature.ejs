<% const still = coverOf(item); %>
<article class="media-feature float-saucer float-saucer--rounded float-saucer--lift-sm group">
  <a href="/archive/<%= item.slug %>" class="block no-underline">
    <% if (still) { %>
    <span class="relative block aspect-video overflow-hidden">
      <img src="<%= still %>" alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.015]" />
      <span class="absolute inset-0 flex items-center justify-center" aria-hidden>
        <span class="flex size-12 items-center justify-center rounded-full border border-paper/80 bg-forest-950/35 text-paper transition-colors group-hover:border-wheat group-hover:text-wheat">
          <svg viewBox="0 0 24 24" class="size-4"><path d="M9 6.5v11l9-5.5-9-5.5Z" fill="currentColor" /></svg>
        </span>
      </span>
    </span>
    <% } else { %>
    <span class="t-meta flex items-center gap-3 border-y border-forest-950/12 py-5">
      <span class="flex size-10 items-center justify-center rounded-full border border-forest-950/25 text-forest-950" aria-hidden>
        <svg viewBox="0 0 24 24" class="size-3.5"><path d="M9 6.5v11l9-5.5-9-5.5Z" fill="currentColor" /></svg>
      </span>
      ڤیدیۆ / چاوپێکەوتن
    </span>
    <% } %>
    <p class="t-meta mt-4"><%= formatKuDate(item.publishedAt) %></p>
    <h3 class="<%= compact ? 't-h3 mt-2' : 't-h2 mt-3' %>">
      <span class="link-underline text-forest-950"><%= item.title %></span>
    </h3>
  </a>
</article>
