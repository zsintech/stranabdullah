<div class="archive-years">
  <% groups.forEach(function (group) { %>
  <section class="archive-year" aria-labelledby="year-<%= group.year %>">
    <div class="archive-year__rail lg:sticky lg:top-28 lg:self-start">
      <div class="float-saucer float-saucer--pill float-saucer--lift-sm archive-year__badge">
        <h2 id="year-<%= group.year %>" class="archive-year__label"><%= group.display %></h2>
        <p class="archive-year__count"><%= group.count %> تۆمار</p>
      </div>
    </div>

    <div class="archive-year__entries">
      <% group.items.forEach(function (entry) { %>
      <%- include("archive-entry", { item: entry }) %>
      <% }); %>
    </div>
  </section>
  <% }); %>
</div>
