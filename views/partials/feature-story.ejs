<%
  const cover = coverOf(item);
  const date = formatKuNumeric(item.publishedAt);
  const year = item.year;
%>
<article class="feature-spread float-saucer float-saucer--rounded float-saucer--lift-sm group <%= cover ? '' : 'feature-spread--text' %>">
  <% if (year) { %>
  <span aria-hidden class="decorative-year feature-spread__year"><%= kuDigits(year) %></span>
  <% } %>

  <% if (cover) { %>
  <div class="relative z-[1] grid items-start gap-6 md:gap-8 lg:grid-cols-12 lg:gap-x-8">
    <a href="/archive/<%= item.slug %>" tabindex="-1" aria-hidden class="feature-spread__media relative block aspect-[16/10] overflow-hidden rounded-[0.85rem] lg:col-span-5 lg:aspect-[5/4]">
      <%- include("editorial-image", {
        imgSrc: cover,
        imgAlt: "",
        imgFill: true,
        imgTone: "documentary",
        imgMask: "toward-copy",
        mediaClassName: "transition-transform duration-500 group-hover:scale-[1.015]"
      }) %>
    </a>
    <div class="feature-spread__copy lg:col-span-7">
      <%- include("feature-meta", { item: item, date: date }) %>
      <%- include("feature-body", { item: item }) %>
    </div>
  </div>
  <% } else { %>
  <div class="feature-spread__lede relative z-[1]">
    <%- include("feature-meta", { item: item, date: date }) %>
    <%- include("feature-body", { item: item }) %>
  </div>
  <% } %>
</article>
