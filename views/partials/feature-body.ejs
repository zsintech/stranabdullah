<%- include("gold-rule", { extraClass: "mt-2.5 max-w-[7.5rem] opacity-75" }) %>
<h3 class="mt-3 max-w-[38rem]">
  <a href="/archive/<%= item.slug %>" class="feature-title link-underline"><%= item.title %></a>
</h3>
<% if (item.summary) { %>
<p class="feature-spread__summary mt-3"><%= item.summary %></p>
<% } %>
<p class="mt-4">
  <a href="/archive/<%= item.slug %>" class="t-meta inline-flex items-center gap-2 font-semibold text-forest-900 no-underline">
    <span class="link-underline">زیاتر بخوێنەوە</span>
    <span class="arrow-slide" aria-hidden>←</span>
  </a>
</p>
