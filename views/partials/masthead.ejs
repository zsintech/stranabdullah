<%
  const onForest = typeof tone !== "undefined" && tone === "forest";
  const word = typeof decorativeWord !== "undefined" && decorativeWord ? decorativeWord : title;
%>
<section class="editorial-spread <%= onForest ? 'editorial-field-forest page-masthead page-masthead--forest' : 'editorial-field-cream page-masthead' %>">
  <span class="decorative-word page-masthead__word" aria-hidden><%= word %></span>

  <% if (typeof ghostSrc !== "undefined" && ghostSrc) { %>
  <div class="page-masthead__ghost hidden md:block" aria-hidden>
    <%- include("editorial-image", {
      imgSrc: ghostSrc,
      imgAlt: "",
      imgFill: true,
      imgTone: "ghost",
      imgMask: "toward-copy",
      mediaClassName: "object-cover object-[40%_20%]"
    }) %>
  </div>
  <% } %>

  <%- include("botanical", { extraClass: "pointer-events-none absolute -bottom-16 -end-10 hidden h-64 w-auto opacity-[0.07] md:block" }) %>

  <% if (typeof showTulip !== "undefined" && showTulip) { %>
  <%- include("tulip-mark", { extraClass: "pointer-events-none absolute -bottom-10 start-[8%] hidden h-28 w-auto text-tulip/80 md:block" }) %>
  <% } %>

  <div class="site-container page-masthead__content relative z-[1]">
    <% if (typeof eyebrow !== "undefined" && eyebrow) { %>
    <p class="t-eyebrow<%= onForest ? ' page-masthead__eyebrow--on-dark' : '' %>"><%= eyebrow %></p>
    <% } %>
    <h1 class="t-h1 mt-1<%= onForest ? ' page-masthead__title--on-dark' : '' %>"><%= title %></h1>
    <%- include("gold-rule", { extraClass: "mt-5 max-w-[14rem]" }) %>
    <% if (typeof description !== "undefined" && description) { %>
    <p class="t-lead mt-5 max-w-2xl<%= onForest ? ' page-masthead__lead--on-dark' : '' %>"><%= description %></p>
    <% } %>
    <% if (typeof mastheadInner !== "undefined" && mastheadInner) { %>
    <%- mastheadInner %>
    <% } %>
  </div>
</section>
