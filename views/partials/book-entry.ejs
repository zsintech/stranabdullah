<% const cover = coverOf(item); const hasPdf = item.media && item.media.documentUrl; %>
<article class="book-entry float-saucer float-saucer--rounded float-saucer--lift-sm<%= flip ? ' book-entry--flip' : '' %>">
  <% if (cover) { %>
  <div class="book-entry__media">
    <img src="<%= cover %>" alt="" width="480" height="640" loading="lazy" decoding="async" />
  </div>
  <% } else { %>
  <div class="book-entry__media book-entry__year-only" aria-hidden>
    <p class="t-year text-[3.5rem]"><%= item.year ? kuDigits(item.year) : "" %></p>
  </div>
  <% } %>
  <div class="book-entry__copy">
    <% if (item.year) { %><p class="t-meta"><%= kuDigits(item.year) %></p><% } %>
    <h3 class="t-h3 mt-1.5">
      <a href="/archive/<%= item.slug %>" class="link-underline text-forest-950"><%= item.title %></a>
    </h3>
    <% if (item.summary) { %>
    <p class="mt-3 w-full leading-[1.85] text-ink/85"><%= item.summary %></p>
    <% } %>
    <% if (hasPdf) { %><p class="book-entry__pdf-badge mt-3">PDF · خوێندنەوە و داگرتن</p><% } %>
    <p class="mt-5">
      <a href="/archive/<%= item.slug %>" class="group t-meta inline-flex items-center gap-2 font-semibold text-forest-900 no-underline">
        <span class="link-underline"><%= hasPdf ? "کردنەوەی کتێب" : "خوێندنەوە" %></span>
        <span class="arrow-slide" aria-hidden>←</span>
      </a>
    </p>
  </div>
</article>
