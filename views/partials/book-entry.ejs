<% const cover = visualOf(item); const hasPdf = item.media && item.media.documentUrl; %>
<a href="/archive/<%= item.slug %>" class="book-entry float-saucer float-saucer--rounded float-saucer--lift-sm group">
  <% if (cover) { %>
  <div class="book-entry__media">
    <img src="<%= cover %>" alt="" width="480" height="640" loading="lazy" decoding="async" />
  </div>
  <% } else { %>
  <div class="book-entry__media book-entry__year-only" aria-hidden>
    <p class="t-year text-[2.75rem]"><%= item.year ? kuDigits(item.year) : "" %></p>
  </div>
  <% } %>
  <div class="book-entry__copy">
    <% if (item.year) { %><p class="t-meta book-entry__year"><%= kuDigits(item.year) %></p><% } %>
    <h3 class="book-entry__title"><%= item.title %></h3>
    <% if (item.summary) { %>
    <p class="book-entry__excerpt"><%= item.summary %></p>
    <% } %>
    <p class="book-entry__cta t-meta">
      <span class="link-underline"><%= hasPdf ? "کردنەوەی کتێب" : "خوێندنەوە" %></span>
      <span class="arrow-slide" aria-hidden>←</span>
    </p>
  </div>
</a>
