<!DOCTYPE html>
<html lang="ckb" dir="rtl" data-scroll-behavior="smooth" class="font-amiri">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ستران عەبدوڵڵا</title>
    <meta name="description" content="<%= typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : SITE_DESCRIPTION %>" />
    <% if (typeof canonical !== "undefined" && canonical) { %>
    <link rel="canonical" href="<%= canonical %>" />
    <% } %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/app.css?v=20260827d" />
    <% if (onHome) { %>
    <link rel="preload" as="image" href="/brand/hero4.png" />
    <link rel="stylesheet" href="/css/peel.css?v=20141224b" />
    <link rel="stylesheet" href="/css/home.css?v=20260901a" />
    <% } else if (typeof loadLaneCss !== "undefined" && loadLaneCss) { %>
    <link rel="stylesheet" href="/css/home.css?v=20260901a" />
    <% } %>
    <style>
      :root {
        --font-arabic: "Amiri", "Noto Naskh Arabic", serif;
        --font-vazir: "Amiri", "Noto Naskh Arabic", serif;
        --font-ui: "Amiri", "Noto Naskh Arabic", serif;
        --font-display: "Amiri", "Noto Naskh Arabic", serif;
        --font-body: "Amiri", "Noto Naskh Arabic", serif;
        --default-font-family: "Amiri", "Noto Naskh Arabic", serif;
      }
      html, body { font-family: "Amiri", "Noto Naskh Arabic", serif; }
    </style>
  </head>
  <body class="min-h-screen bg-cream-100 text-ink antialiased<%= typeof isBook !== 'undefined' && isBook ? ' is-book-page' : '' %>">
    <a href="#main" class="skip-link">بچۆ بۆ ناوەڕۆک</a>
    <%- include("partials/header") %>
    <main id="main"><%- body %></main>
    <%- include("partials/footer") %>
    <script src="/js/header.js?v=20260826a" defer></script>
  </body>
</html>
