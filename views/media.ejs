<div class="bg-cream-100">
  <%- include("partials/masthead", {
    tone: "forest",
    eyebrow: "دەنگ و وێنە",
    title: "میدیا",
    description: "چاوپێکەوتن، ڤیدیۆ و ئەرشیفی وێنە.",
    ghostSrc: "/brand/banner.png"
  }) %>

  <div class="site-container site-container--body">
    <div class="space-y-16">
      <% if (empty) { %>
      <%- include("partials/empty-state", {
        emptyTitle: "هێشتا میدیا تۆمار نەکراوە",
        emptyNote: "چاوپێکەوتن و ڤیدیۆ و وێنەکان دواتر کاتالۆگ دەکرێن. لە ئێستادا نووسینەکان لە ئەرشیفدان."
      }) %>
      <% } %>

      <% if (interviews.length) { %>
      <section aria-labelledby="interviews-heading">
        <%- include("partials/section-heading", { headingId: "interviews-heading", headingTitle: "چاوپێکەوتن", count: interviewCount }) %>
        <div class="space-y-10">
          <%- include("partials/media-feature", { item: interviews[0], compact: false }) %>
          <% if (interviews.length > 1) { %>
          <ul class="content-list float-saucer float-saucer--rounded float-saucer--lift-sm">
            <% interviews.slice(1).forEach(function (item) { %>
            <li>
              <a href="/archive/<%= item.slug %>" class="content-list__link content-list__link--grid group">
                <span class="t-meta"><%= formatKuDate(item.publishedAt) %></span>
                <span class="link-underline font-display text-lg font-bold text-forest-950"><%= item.title %></span>
              </a>
            </li>
            <% }); %>
          </ul>
          <% } %>
        </div>
      </section>
      <% } %>

      <% if (videos.length) { %>
      <section aria-labelledby="videos-heading">
        <%- include("partials/section-heading", { headingId: "videos-heading", headingTitle: "ڤیدیۆ", count: videoCount }) %>
        <div class="grid gap-10 md:grid-cols-2">
          <% videos.forEach(function (item) { %>
          <%- include("partials/media-feature", { item: item, compact: true }) %>
          <% }); %>
        </div>
      </section>
      <% } %>

      <% if (photos.length) { %>
      <section aria-labelledby="photos-heading">
        <%- include("partials/section-heading", { headingId: "photos-heading", headingTitle: "ئەرشیفی وێنە", count: photoCount }) %>
        <ul class="grid gap-6 sm:grid-cols-6">
          <% photos.forEach(function (item, index) { const image = coverOf(item); const wide = index % 3 === 0; %>
          <li class="<%= wide ? 'sm:col-span-4' : 'sm:col-span-2' %>">
            <figure class="photo-tile float-saucer float-saucer--rounded float-saucer--lift-sm group">
              <a href="/archive/<%= item.slug %>" class="block no-underline">
                <% if (image) { %>
                <span class="photo-tile__media relative <%= wide ? 'aspect-[3/2]' : 'aspect-[4/5]' %>">
                  <img src="<%= image %>" alt="<%= item.title %>" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.015]" />
                </span>
                <% } %>
                <figcaption class="t-meta mt-3 px-1">
                  <% if (item.year) { %><span class="font-display font-bold text-forest-950"><%= kuDigits(item.year) %></span><% } %>
                  <% if (item.location) { %><span class="ms-2"><%= item.location %></span><% } %>
                  <span class="mt-1 block text-ink-muted"><%= item.title %></span>
                </figcaption>
              </a>
            </figure>
          </li>
          <% }); %>
        </ul>
      </section>
      <% } %>
    </div>
  </div>
</div>
