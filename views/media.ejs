<div class="bg-cream-100">
  <%- include("partials/masthead", {
    tone: "forest",
    eyebrow: "دەنگ و وێنە",
    title: "میدیا",
    description: "ڤیدیۆکانی یوتیوب بەپێی کۆڕ، چاوپێکەوتن و ئەرشیف، لەگەڵ وێنەکان.",
    ghostSrc: "/brand/banner.png",
    mastheadInner: '<p class="mt-6"><a href="https://www.youtube.com/@StranAbdulla" class="inline-flex items-center gap-2 text-sm font-medium text-cream-100/85 hover:text-cream-100 transition-colors" rel="noopener noreferrer" target="_blank"><span class="link-underline">@StranAbdulla</span><span class="arrow-slide" aria-hidden="true">←</span></a></p>',
  }) %>

  <%- include("partials/video-lane", {
    entries: typeof kurdiEntries !== "undefined" ? kurdiEntries : [],
    headingKicker: (typeof kurdiCount !== "undefined" ? kurdiCount : "٠") + " ڤیدیۆ",
    headingTitle: "کۆڕ",
    laneHeadingId: "kurdi-videos-heading",
    playlistUrl: typeof kurdiPlaylist !== "undefined" && kurdiPlaylist ? kurdiPlaylist.url : "",
    playlistLabel: "لیستی کۆڕ",
    laneMod: "video-lane--editorial",
    showEmpty: false,
  }) %>

  <%- include("partials/video-lane", {
    entries: typeof interviewEntries !== "undefined" ? interviewEntries : [],
    headingKicker: (typeof interviewCount !== "undefined" ? interviewCount : "٠") + " ڤیدیۆ",
    headingTitle: "چاوپێکەوتن",
    laneHeadingId: "interviews-heading",
    playlistUrl: typeof interviewPlaylist !== "undefined" && interviewPlaylist ? interviewPlaylist.url : "",
    playlistLabel: "لیستی چاوپێکەوتن",
    laneMod: "video-lane--editorial",
    showEmpty: false,
  }) %>

  <%- include("partials/video-lane", {
    entries: typeof archiveVideoEntries !== "undefined" ? archiveVideoEntries : [],
    headingKicker: (typeof videoCount !== "undefined" ? videoCount : "٠") + " ڤیدیۆ",
    headingTitle: "ئەرشیف",
    laneHeadingId: "videos-heading",
    playlistUrl: typeof archivePlaylist !== "undefined" && archivePlaylist ? archivePlaylist.url : "",
    playlistLabel: "لیستی ئەرشیف",
    laneMod: "video-lane--editorial",
    showEmpty: false,
  }) %>

  <%
    const fromAdminPhotos = (typeof photos !== "undefined" ? photos : [])
      .map(function (item, index) {
        const src = coverOf(item);
        if (!src) return null;
        return {
          href: "/archive/" + item.slug,
          src: src,
          title: item.title,
          yearLabel: item.location || (item.year ? "ساڵی " + kuDigits(item.year) : ""),
          wide: index % 3 === 1,
        };
      })
      .filter(Boolean);
    const photoShots = fromAdminPhotos.length ? fromAdminPhotos : archivePhotoFallbacks;
  %>

  <%- include("partials/photo-lane", {
    shots: photoShots,
    headingKicker: "ئەرشیف",
    headingTitle: "وێنە",
    laneHeadingId: "media-photos-heading",
    laneMoreHref: "/archive?type=photo",
    laneMoreLabel: "هەموو وێنەکان",
    laneMod: " photo-lane--home",
  }) %>
</div>

<script src="/js/video-lane.js?v=20260902n" defer></script>
