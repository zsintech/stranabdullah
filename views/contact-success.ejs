<div class="float-saucer float-saucer--rounded float-saucer--lift-sm contact-flash-saucer mb-8 max-w-2xl">
  <% if (flash === "sent") { %>
  <p class="t-h3">پەیامەکەت گەیشت.</p>
  <p class="t-meta mt-2">سوپاس. نووسینگە وەڵامت دەداتەوە.</p>
  <% } else { %>
  <p class="t-h3">پەیامەکە وەرگیرا.</p>
  <p class="t-meta mt-2">لەم دۆخە خۆجێییەدا پاشەکەوت ناکرێت — Firebase بەردەست نییە.</p>
  <% } %>
</div>
