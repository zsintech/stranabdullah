<%
  const publishedDate = item && item.publishedAt ? String(item.publishedAt).slice(0, 10) : "";
  const cover = item ? (item.media.coverImage && (item.media.coverImage.cachedUrl || item.media.coverImage.remoteUrl)) : "";
  const coverAlt = item && item.media.coverImage && item.media.coverImage.alt ? item.media.coverImage.alt : "";
  const documentUrl = item && item.media && item.media.documentUrl ? item.media.documentUrl : "";
  const videoUrl = item && item.media && item.media.videoUrl ? item.media.videoUrl : "";
  const currentStatus = item ? item.status : (typeof defaultStatus !== "undefined" ? defaultStatus : "draft");
  const activeType = item ? item.contentType : (typeof defaultType !== "undefined" && defaultType ? defaultType : "article");
  const ytThumb = videoUrl ? youtubeThumbnail(videoUrl) : "";
  const mediaKinds = ["interview", "podcast", "video", "photo", "book", "audiobook"];
  const isWritingKind = mediaKinds.indexOf(activeType) < 0;
  const isBookKind = activeType === "book" || activeType === "audiobook";
  const isMediaKind = ["interview", "podcast", "video", "photo"].indexOf(activeType) >= 0;
  const quickAddFlow = !item && (typeof fromQuickAdd !== "undefined" && fromQuickAdd);
  const isArchived = item && item.status === "archived";
  const isPublished = item && item.status === "published";
  const isDraft = item && item.status === "draft";
%>
<section class="admin-editor-page">
  <%- include("partials/breadcrumb") %>
  <% if (isArchived) { %>
  <p class="admin-banner admin-banner--archived">ئەم تۆمارە شاردراوەتەوە — لە ماڵپەڕدا نیشان نادرێت. بۆ گەڕاندنەوە دۆخ بگۆڕە بۆ بڵاوکراوە یان ڕەشنووس.</p>
  <% } %>
  <header class="admin-editor-header">
    <div>
      <p class="admin-kicker"><%= item ? "دەستکاری" : "نوێ" %></p>
      <h1 class="t-h2"><%= item ? item.title : "تۆماری نوێ" %></h1>
    </div>
    <div class="admin-editor-header__actions">
      <% if (item) { %>
      <a class="btn btn-light btn-sm" href="/admin/items/<%= item.id %>/preview" target="_blank" rel="noopener">پێشبینین</a>
      <% if (isPublished) { %>
      <a class="btn btn-light btn-sm" href="/archive/<%= item.slug %>" target="_blank" rel="noopener">بینینی گشتی</a>
      <% } %>
      <% } %>
    </div>
  </header>
  <%- include("../partials/gold-rule", { extraClass: "mb-8 max-w-[14rem]" }) %>

  <form
    id="item-form"
    method="post"
    action="<%= item ? "/admin/items/" + item.id : "/admin/items" %>"
    enctype="multipart/form-data"
    class="admin-editor"
    data-admin-editor
    data-is-new="<%= item ? "false" : "true" %>"
  >
    <input type="hidden" name="_csrf" value="<%= csrf %>" />

    <div class="admin-editor-main">
      <details class="admin-kind-details float-saucer float-saucer--rounded admin-card admin-kind-card" data-kind-details>
        <summary class="admin-kind-summary">
          <span class="admin-kind-summary__label">جۆری تۆمار: <strong data-kind-label><%= contentTypeLabels[activeType] %></strong></span>
          <span class="admin-kind-summary__toggle">گۆڕین</span>
        </summary>
        <div class="admin-kind-details__body">
        <h2 class="admin-card__title">جۆری تۆمار</h2>
        <p class="admin-card__hint">هەڵبژێرە ئەم تۆمارە لە کوێ دەردەکەوێت — سێ جۆری یوتیوب لە پەڕەی میدیا، وێنە، یان نووسین/کتێب.</p>
        <div class="admin-kind-grid" role="radiogroup" aria-label="جۆری تۆمار" data-kind-grid>
          <label class="admin-kind<%= activeType === "interview" ? " is-active" : "" %>">
            <input type="radio" name="contentType" value="interview" <%= activeType === "interview" ? "checked" : "" %> data-kind />
            <span class="admin-kind__label">چاوپێکەوتن</span>
            <span class="admin-kind__hint">یوتیوب · پەڕەی میدیا</span>
          </label>
          <label class="admin-kind<%= activeType === "podcast" ? " is-active" : "" %>">
            <input type="radio" name="contentType" value="podcast" <%= activeType === "podcast" ? "checked" : "" %> data-kind />
            <span class="admin-kind__label">پۆدکاست</span>
            <span class="admin-kind__hint">یوتیوب · پەڕەی میدیا</span>
          </label>
          <label class="admin-kind<%= activeType === "video" ? " is-active" : "" %>">
            <input type="radio" name="contentType" value="video" <%= activeType === "video" ? "checked" : "" %> data-kind />
            <span class="admin-kind__label">ڤیدیۆی ئەرشیف</span>
            <span class="admin-kind__hint">یوتیوب · پەڕەی میدیا</span>
          </label>
          <label class="admin-kind<%= activeType === "photo" ? " is-active" : "" %>">
            <input type="radio" name="contentType" value="photo" <%= activeType === "photo" ? "checked" : "" %> data-kind />
            <span class="admin-kind__label">وێنە</span>
            <span class="admin-kind__hint">بارکردنی وێنە · میدیا / سەرەکی</span>
          </label>
          <label class="admin-kind<%= isWritingKind ? " is-active" : "" %>" data-kind-writing>
            <input type="radio" name="contentType" value="<%= isWritingKind ? activeType : "article" %>" <%= isWritingKind ? "checked" : "" %> data-kind data-kind-writing-radio />
            <span class="admin-kind__label">نووسین</span>
            <span class="admin-kind__hint">وتار، بۆچوون، لێدوان...</span>
          </label>
          <label class="admin-kind<%= isBookKind ? " is-active" : "" %>">
            <input type="radio" name="contentType" value="book" <%= isBookKind ? "checked" : "" %> data-kind />
            <span class="admin-kind__label">کتێب</span>
            <span class="admin-kind__hint">بەرگ + PDF</span>
          </label>
        </div>

        <div class="admin-writing-type" data-panel="writing-extra" <%= isWritingKind ? "" : "hidden" %>>
          <label class="field-label" for="writingType">جۆری نووسین</label>
          <select class="field" id="writingType" data-writing-type>
            <% ["article","speech","opinion","statement","announcement","document","other"].forEach(function (type) { %>
            <option value="<%= type %>" <%= activeType === type ? "selected" : "" %>><%= contentTypeLabels[type] %></option>
            <% }); %>
          </select>
        </div>

        <ul class="admin-kind-checklist" data-kind-checklist hidden>
          <li data-check="title">ناونیشان</li>
          <li data-check="youtube">لینکی یوتیوب</li>
          <li data-check="cover">وێنەی بەرگ</li>
          <li data-check="published">بڵاوکراوە</li>
        </ul>
        </div>
      </details>

      <div class="admin-card float-saucer float-saucer--rounded">
        <div class="admin-field-stack">
          <div>
            <label class="field-label" for="title" data-label-title>ناونیشان</label>
            <input class="field field--title" id="title" name="title" required value="<%= item ? item.title : "" %>" placeholder="ناونیشان..." />
          </div>
          <div>
            <label class="field-label" for="summary" data-label-summary>کورتە / وەسف</label>
            <textarea class="field admin-textarea" id="summary" name="summary" rows="2" placeholder="کورتەیەک بۆ لیست و گەڕان..."><%= item ? item.summary : "" %></textarea>
          </div>
        </div>
      </div>

      <div class="admin-card float-saucer float-saucer--rounded" data-panel="youtube">
        <h2 class="admin-card__title">لینکی یوتیوب <%- include("partials/help-btn", { key: "youtube" }) %></h2>
        <div class="admin-field-stack">
          <div>
            <label class="field-label" for="videoUrl">URL</label>
            <input
              class="field"
              id="videoUrl"
              name="videoUrl"
              dir="ltr"
              placeholder="https://www.youtube.com/watch?v=…"
              value="<%= videoUrl %>"
              data-youtube-url
            />
          </div>
          <div class="admin-youtube-preview" data-youtube-preview <%= ytThumb ? "" : "hidden" %>>
            <img src="<%= ytThumb || "" %>" alt="" data-youtube-thumb />
            <div class="admin-youtube-preview__meta">
              <p class="t-meta" data-youtube-id><%= videoUrl && youtubeId(videoUrl) ? "ID: " + youtubeId(videoUrl) : "" %></p>
              <a class="admin-link" href="<%= videoUrl || "#" %>" target="_blank" rel="noopener" data-youtube-open <%= videoUrl ? "" : "hidden" %>>کردنەوە لە یوتیوب</a>
            </div>
          </div>
        </div>
      </div>

      <div class="admin-card float-saucer float-saucer--rounded" data-panel="cover">
        <h2 class="admin-card__title" data-label-cover>وێنەی بەرگ <%- include("partials/help-btn", { key: "cover" }) %></h2>
        <label class="admin-drop" data-drop="image">
          <input class="admin-drop__input" id="cover" name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif" />
          <span class="admin-drop__text">کلیک بکە یان وێنە بکێشە ئێرە</span>
          <span class="admin-drop__hint">JPEG, PNG, WebP · تا ٤٠ مێگابایت</span>
        </label>
        <div class="admin-cover-preview" data-cover-preview <%= cover ? "" : "hidden" %>>
          <img src="<%= cover || "" %>" alt="" />
        </div>
        <p class="admin-file-name t-meta" data-file-name hidden></p>
        <details class="admin-cover-extra">
          <summary class="admin-details__summary">یان URL / وەسف</summary>
          <div class="admin-field-stack mt-4">
            <div>
              <label class="field-label" for="coverUrl">URL</label>
              <input class="field" id="coverUrl" name="coverUrl" dir="ltr" value="<%= cover || "" %>" placeholder="https://..." data-cover-url />
            </div>
            <div>
              <label class="field-label" for="coverAlt">وەسفی وێنە (alt) <%- include("partials/help-btn", { key: "coverAlt" }) %></label>
              <input class="field" id="coverAlt" name="coverAlt" value="<%= coverAlt %>" placeholder="وەسف بۆ دەستگەیشتن و گەڕان" />
            </div>
          </div>
        </details>
      </div>

      <div class="admin-card float-saucer float-saucer--rounded" data-panel="home-gallery">
        <h2 class="admin-card__title">لە پەڕەی سەرەکی <%- include("partials/help-btn", { key: "homeGallery" }) %></h2>
        <div class="admin-field-stack">
          <label class="admin-check admin-check--card">
            <input type="checkbox" name="homeGallery" data-home-gallery-toggle <%= item && item.extras && item.extras.homeGallery ? "checked" : "" %> />
            <span>نیشاندان لە کارۆسێلی وێنەی سەرەکی</span>
          </label>
          <div class="admin-grid admin-grid--2" data-home-gallery-extras <%= item && item.extras && item.extras.homeGallery ? "" : "hidden" %>>
            <div>
              <label class="field-label" for="homeGalleryOrder">ڕیز <%- include("partials/help-btn", { key: "homeGalleryOrder" }) %></label>
              <input
                class="field"
                id="homeGalleryOrder"
                name="homeGalleryOrder"
                type="number"
                min="1"
                dir="ltr"
                value="<%= item && item.extras && item.extras.homeGalleryOrder ? item.extras.homeGalleryOrder : "" %>"
                placeholder="1"
              />
            </div>
            <label class="admin-check admin-check--card" style="align-self:end">
              <input type="checkbox" name="homeGalleryWide" <%= item && item.extras && item.extras.homeGalleryWide ? "checked" : "" %> />
              <span>وێنەی فراوان <%- include("partials/help-btn", { key: "homeGalleryWide" }) %></span>
            </label>
          </div>
        </div>
      </div>

      <div class="admin-card float-saucer float-saucer--rounded admin-pdf-card" data-panel="pdf" data-pdf-admin>
        <h2 class="admin-card__title">فایلی PDF <%- include("partials/help-btn", { key: "pdf" }) %></h2>
        <label class="admin-drop admin-drop--pdf" data-drop="pdf">
          <input class="admin-drop__input" id="document" name="document" type="file" accept="application/pdf,.pdf" />
          <span class="admin-drop__text">کلیک بکە یان PDF بکێشە ئێرە</span>
          <span class="admin-drop__hint">تا ٤٠ مێگابایت</span>
        </label>
        <p class="admin-file-name t-meta" data-file-name hidden></p>
        <div class="admin-pdf-current" data-pdf-current <%= documentUrl ? "" : "hidden" %>>
          <span class="admin-pdf-current__icon" aria-hidden>PDF</span>
          <a href="<%= documentUrl || "#" %>" target="_blank" rel="noopener" dir="ltr" data-pdf-link><%= documentUrl ? "فایلی ئێستا" : "" %></a>
        </div>
        <details class="admin-cover-extra">
          <summary class="admin-details__summary">یان URL / وردەکاری</summary>
          <div class="admin-field-stack mt-4">
            <div>
              <label class="field-label" for="documentUrl">URL</label>
              <input class="field" id="documentUrl" name="documentUrl" dir="ltr" value="<%= documentUrl %>" placeholder="https://..." data-pdf-url />
            </div>
            <div class="admin-grid admin-grid--2">
              <div>
                <label class="field-label" for="publisher">بڵاوکەرەوە</label>
                <input class="field" id="publisher" name="publisher" value="<%= item && item.extras && item.extras.publisher ? item.extras.publisher : "" %>" />
              </div>
              <div>
                <label class="field-label" for="isbn">ISBN <%- include("partials/help-btn", { key: "isbn" }) %></label>
                <input class="field" id="isbn" name="isbn" dir="ltr" value="<%= item && item.extras && item.extras.isbn ? item.extras.isbn : "" %>" />
              </div>
            </div>
          </div>
        </details>
      </div>

      <div class="admin-card float-saucer float-saucer--rounded admin-compose-card" data-panel="body">
        <div class="admin-compose__head">
          <div>
            <h2 class="admin-card__title">دەقی نووسین <%- include("partials/help-btn", { key: "body" }) %></h2>
          </div>
          <div class="admin-editor-tabs" role="tablist" aria-label="دەقی نووسین">
            <button type="button" class="admin-editor-tab is-active" data-editor-tab="write" role="tab" aria-selected="true">نووسین</button>
            <button type="button" class="admin-editor-tab" data-editor-tab="preview" role="tab" aria-selected="false">پێشبینین</button>
          </div>
        </div>

        <div class="admin-compose" data-compose>
          <div class="admin-compose__tools" data-write-tools>
            <button type="button" class="admin-tool" data-format="bold">قەڵەو</button>
            <button type="button" class="admin-tool" data-format="italic">لار</button>
            <button type="button" class="admin-tool" data-format="heading">سەردێڕ</button>
            <button type="button" class="admin-tool" data-format="list">لیست</button>
            <button type="button" class="admin-tool" data-format="quote">وتە</button>
            <button type="button" class="admin-tool" data-format="link">لینک</button>
            <button type="button" class="admin-tool admin-tool--accent" data-upload-inline>وێنە</button>
          </div>
          <div data-write-panel>
            <label class="sr-only" for="body">دەقی نووسین</label>
            <textarea
              class="admin-compose__input"
              id="body"
              name="body"
              rows="10"
              placeholder="دەقەکە لێرە بنووسە…"
            ><%= item ? item.body : "" %></textarea>
          </div>
          <div class="admin-preview prose" data-preview-panel hidden></div>
        </div>
        <input type="hidden" name="bodyFormat" value="markdown" />
      </div>

      <details class="admin-card float-saucer float-saucer--rounded admin-details">
        <summary class="admin-details__summary">زیاتر — لینک، تاگ، سەرچاوە</summary>
        <div class="admin-field-stack mt-4">
          <div>
            <label class="field-label" for="subtitle" data-label-subtitle>ژێرناونیشان / هێڵی دووەم</label>
            <input class="field" id="subtitle" name="subtitle" value="<%= item && item.subtitle ? item.subtitle : "" %>" placeholder="بۆ وێنە: ساڵ یان شوێن..." />
          </div>
          <div class="admin-grid admin-grid--2">
            <div>
              <label class="field-label" for="slug">لینک (slug) <%- include("partials/help-btn", { key: "slug" }) %></label>
              <input class="field" id="slug" name="slug" dir="ltr" value="<%= item ? item.slug : "" %>" placeholder="auto-from-title" />
            </div>
            <div data-field="location">
              <label class="field-label" for="location">شوێن</label>
              <input class="field" id="location" name="location" value="<%= item && item.location ? item.location : "" %>" placeholder="بۆ وێنە و ڕووداو" />
            </div>
          </div>
          <div data-panel="youtube-extra">
            <label class="field-label" for="outlet">ناوی بەرنامە / کەناڵ</label>
            <input class="field" id="outlet" name="outlet" value="<%= item && item.extras && item.extras.outlet ? item.extras.outlet : "" %>" placeholder="بۆ نموونە: میوانی هەفتە" />
          </div>
          <div class="admin-grid admin-grid--2">
            <div>
              <label class="field-label" for="topics">بابەتەکان <%- include("partials/help-btn", { key: "topics" }) %></label>
              <input class="field" id="topics" name="topics" value="<%= item ? item.topics.join("، ") : "" %>" placeholder="بە کۆما جیا بکەوە" />
            </div>
            <div>
              <label class="field-label" for="tags">تاگ <%- include("partials/help-btn", { key: "tags" }) %></label>
              <input class="field" id="tags" name="tags" value="<%= item ? item.tags.join("، ") : "" %>" />
            </div>
          </div>
          <div class="admin-grid admin-grid--2">
            <div>
              <label class="field-label" for="author">نووسەر</label>
              <input class="field" id="author" name="author" value="<%= item && item.extras && item.extras.author ? item.extras.author : "" %>" />
            </div>
            <div>
              <label class="field-label" for="audioUrl">لینکی دەنگ <%- include("partials/help-btn", { key: "audioUrl" }) %></label>
              <input class="field" id="audioUrl" name="audioUrl" dir="ltr" value="<%= item && item.media && item.media.audioUrl ? item.media.audioUrl : "" %>" />
            </div>
          </div>
        </div>
      </details>

      <div class="admin-form-footer admin-form-footer--sticky">
        <button class="btn btn-primary" type="submit" name="intent" value="save">پاشەکەوت</button>
        <button class="btn btn-secondary" type="submit" name="intent" value="publish">پاشەکەوت و بڵاوکردنەوە</button>
        <button class="btn btn-light" type="submit" name="intent" value="save_list">پاشەکەوت و گەڕانەوە</button>
        <button class="btn admin-btn-hide" type="submit" name="intent" value="archive_list">پاشەکەوت و شاردنەوە</button>
        <% if (isMediaKind) { %>
        <span class="admin-footer-action">
          <button class="btn btn-light" type="submit" name="intent" value="publish_new">بڵاوکردنەوە و نوێی تر</button>
          <%- include("partials/help-btn", { key: "publishNew" }) %>
        </span>
        <% } %>
        <a class="btn btn-light" href="/admin/items">گەڕانەوە</a>
      </div>
    </div>

    <aside class="admin-editor-sidebar">
      <div class="admin-card float-saucer float-saucer--rounded">
        <h2 class="admin-card__title">دۆخ <%- include("partials/help-btn", { key: "status" }) %></h2>
        <div class="admin-status-picker">
          <% ["draft", "published", "archived"].forEach(function (status) { %>
          <label class="admin-status-option admin-status-option--<%= status %>">
            <input type="radio" name="status" value="<%= status %>" <%= currentStatus === status ? "checked" : "" %> />
            <span class="admin-status-option__label"><%= statusLabels[status] %></span>
            <span class="admin-status-option__hint"><%= statusHints[status] %></span>
          </label>
          <% }); %>
        </div>
      </div>

      <div class="admin-card float-saucer float-saucer--rounded">
        <h2 class="admin-card__title">وردەکاری</h2>
        <div class="admin-field-stack">
          <div>
            <label class="field-label" for="language">زمان</label>
            <select class="field" id="language" name="language">
              <option value="ku" <%= !item || item.language === "ku" ? "selected" : "" %>>کوردی</option>
              <option value="ar" <%= item && item.language === "ar" ? "selected" : "" %>>عەرەبی</option>
              <option value="en" <%= item && item.language === "en" ? "selected" : "" %>>ئینگلیزی</option>
            </select>
          </div>
          <div>
            <label class="field-label" for="publishedAt">بەرواری بڵاوکردنەوە</label>
            <input class="field" id="publishedAt" name="publishedAt" type="date" value="<%= publishedDate %>" />
          </div>
          <div>
            <label class="field-label" for="year">ساڵ</label>
            <input class="field" id="year" name="year" type="number" value="<%= item && item.year ? item.year : "" %>" />
          </div>
          <label class="admin-check admin-check--card">
            <input type="checkbox" name="featured" <%= item && item.featured ? "checked" : "" %> />
            <span>تایبەت لە سەرەکی <%- include("partials/help-btn", { key: "featured" }) %></span>
          </label>
        </div>
      </div>

      <% if (item) { %>
      <div class="admin-card float-saucer float-saucer--rounded admin-card--muted">
        <p class="t-meta">دوایین گۆڕانکاری: <%= item.audit.updatedAt ? item.audit.updatedAt.slice(0, 10) : "" %></p>
        <button class="btn btn-sm admin-btn-danger" type="submit" form="delete-item-form">سڕینەوەی تۆمار</button>
      </div>
      <% } %>
    </aside>
  </form>

  <% if (item) { %>
  <form id="delete-item-form" method="post" action="/admin/items/<%= item.id %>/delete" data-confirm="دڵنیایت لە سڕینەوەی ئەم تۆمارە؟" data-confirm-title="سڕینەوەی تۆمار" data-confirm-danger data-confirm-label="سڕینەوە">
    <input type="hidden" name="_csrf" value="<%= csrf %>" />
  </form>
  <% } %>
</section>
<script src="/js/admin-editor.js?v=20260902a" defer></script>
