<section class="admin-items-page">
  <%- include("partials/breadcrumb") %>
  <header class="admin-page-header">
    <div>
      <h1 class="t-h2">تۆمارەکان</h1>
      <p class="t-meta"><%= kuDigits(typeof pagination !== "undefined" ? pagination.total : items.length) %> تۆمار</p>
    </div>
    <a class="btn btn-primary" href="/admin/items/new">+ نوێ</a>
  </header>
  <%- include("../partials/gold-rule", { extraClass: "mb-8 max-w-[14rem]" }) %>

  <form method="get" action="/admin/items" class="admin-filters admin-filters--bar float-saucer float-saucer--rounded">
    <input class="field" name="q" value="<%= filters.q %>" placeholder="گەڕان بە ناونیشان..." />
    <select class="field" name="status">
      <option value="">هەموو دۆخەکان</option>
      <option value="published" <%= filters.status === "published" ? "selected" : "" %>>بڵاوکراوە</option>
      <option value="draft" <%= filters.status === "draft" ? "selected" : "" %>>ڕەشنووس</option>
      <option value="archived" <%= filters.status === "archived" ? "selected" : "" %>>شاردراوەتەوە</option>
    </select>
    <select class="field" name="type">
      <option value="">هەموو جۆرەکان</option>
      <% contentTypes.forEach(function (type) { %>
      <option value="<%= type %>" <%= filters.type === type ? "selected" : "" %>><%= contentTypeLabels[type] %></option>
      <% }); %>
    </select>
    <button class="btn btn-secondary btn-sm" type="submit">فلتەر</button>
  </form>

  <% if (!items.length) { %>
  <div class="admin-empty">
    <p>هیچ تۆمارێک نەدۆزرایەوە.</p>
    <a class="btn btn-primary btn-sm" href="/admin/items/new">تۆماری نوێ</a>
  </div>
  <% } else { %>
  <div class="admin-item-list">
    <% items.forEach(function (entry) { %>
    <% const thumb = visualOf(entry); %>
    <% const isBook = entry.contentType === "book" || entry.contentType === "audiobook"; %>
    <% const mediaBadge = { interview: "چاوپێکەوتن", podcast: "پۆدکاست", video: "ڤیدیۆ", photo: "وێنە" }; %>
    <% const mediaBadgeKind = { interview: "youtube", podcast: "youtube", video: "youtube", photo: "photo" }; %>
    <article class="admin-item-row float-saucer float-saucer--rounded">
      <a class="admin-item-row__thumb<%= isBook ? " admin-item-row__thumb--book" : "" %>" href="/admin/items/<%= entry.id %>">
        <% if (thumb) { %>
        <img src="<%= thumb %>" alt="" loading="lazy" />
        <% } else { %>
        <span><%= contentTypeLabels[entry.contentType].slice(0, 1) %></span>
        <% } %>
      </a>
      <div class="admin-item-row__main">
        <div class="admin-item-row__head">
          <a class="admin-item-row__title" href="/admin/items/<%= entry.id %>"><%= entry.title %></a>
          <% if (mediaBadge[entry.contentType]) { %>
          <span class="admin-badge admin-badge--type admin-badge--<%= mediaBadgeKind[entry.contentType] %>"><%= mediaBadge[entry.contentType] %></span>
          <% } %>
          <% if (entry.featured) { %><span class="admin-badge admin-badge--featured">تایبەت</span><% } %>
          <% if (entry.extras && entry.extras.homeGallery) { %><span class="admin-badge admin-badge--gallery">سەرەکی · وێنە</span><% } %>
        </div>
        <p class="t-meta admin-item-row__meta">
          <span class="admin-badge admin-badge--<%= entry.status %>"><%= statusLabels[entry.status] %></span>
          · <%= contentTypeLabels[entry.contentType] %>
          <% if (entry.year) { %> · <%= kuDigits(entry.year) %><% } %>
        </p>
      </div>
      <div class="admin-item-row__actions">
        <a class="btn btn-sm btn-secondary" href="/admin/items/<%= entry.id %>">دەستکاری</a>
        <% if (entry.status === "published") { %>
        <%- include("partials/status-form", { entry, csrf, status: "archived", back: "/admin/items", label: "شاردنەوە", buttonClass: "admin-btn-hide", confirm: "دڵنیایت لە شاردنەوەی ئەم تۆمارە لە ماڵپەڕ؟", confirmDanger: true }) %>
        <% } else if (entry.status === "draft") { %>
        <%- include("partials/status-form", { entry, csrf, status: "published", back: "/admin/items", label: "بڵاوکردنەوە", buttonClass: "btn-primary" }) %>
        <% } else if (entry.status === "archived") { %>
        <%- include("partials/status-form", { entry, csrf, status: "published", back: "/admin/items", label: "بڵاوکردنەوە", buttonClass: "btn-primary" }) %>
        <% } %>
        <details class="admin-row-menu">
          <summary class="btn btn-sm btn-light">زیاتر</summary>
          <div class="admin-row-menu__panel">
            <% if (entry.status === "published") { %>
            <a class="btn btn-sm btn-light" href="/archive/<%= entry.slug %>" target="_blank" rel="noopener">بینین</a>
            <%- include("partials/status-form", { entry, csrf, status: "draft", back: "/admin/items", label: "ڕەشنووس", buttonClass: "btn-light" }) %>
            <% } else if (entry.status === "draft") { %>
            <%- include("partials/status-form", { entry, csrf, status: "archived", back: "/admin/items", label: "شاردنەوە", buttonClass: "admin-btn-hide", confirm: "دڵنیایت لە شاردنەوەی ئەم تۆمارە لە ماڵپەڕ؟", confirmDanger: true }) %>
            <% } else if (entry.status === "archived") { %>
            <%- include("partials/status-form", { entry, csrf, status: "draft", back: "/admin/items", label: "ڕەشنووس", buttonClass: "btn-light" }) %>
            <% } %>
          </div>
        </details>
      </div>
    </article>
    <% }); %>
  </div>

  <% if (typeof pagination !== "undefined" && pagination.totalPages > 1) { %>
  <% const qs = function (pageNum) {
    const parts = [];
    if (filters.q) parts.push("q=" + encodeURIComponent(filters.q));
    if (filters.status) parts.push("status=" + encodeURIComponent(filters.status));
    if (filters.type) parts.push("type=" + encodeURIComponent(filters.type));
    parts.push("page=" + pageNum);
    return "?" + parts.join("&");
  }; %>
  <nav class="admin-pagination" aria-label="پەڕەکان">
    <p class="admin-pagination__meta">پەڕەی <%= kuDigits(pagination.page) %> لە <%= kuDigits(pagination.totalPages) %> · <%= kuDigits(pagination.total) %> تۆمار</p>
    <div class="admin-pagination__links">
      <% if (pagination.page > 1) { %>
      <a class="btn btn-sm btn-light" href="/admin/items<%= qs(pagination.page - 1) %>">← پێشوو</a>
      <% } %>
      <% if (pagination.page < pagination.totalPages) { %>
      <a class="btn btn-sm btn-light" href="/admin/items<%= qs(pagination.page + 1) %>">دواتر →</a>
      <% } %>
    </div>
  </nav>
  <% } %>
  <% } %>
</section>
