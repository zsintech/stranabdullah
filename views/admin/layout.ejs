<!DOCTYPE html>
<html lang="ckb" dir="rtl" class="font-amiri">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title><%= pageTitle ? pageTitle + " · بەڕێوەبەر" : "بەڕێوەبەر" %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/app.css?v=20260825b" />
    <link rel="stylesheet" href="/css/admin.css?v=20260825a" />
    <style>
      :root {
        --font-arabic: "Amiri", "Noto Naskh Arabic", serif;
        --font-vazir: "Amiri", "Noto Naskh Arabic", serif;
        --font-ui: "Amiri", "Noto Naskh Arabic", serif;
        --font-display: "Amiri", "Noto Naskh Arabic", serif;
        --font-body: "Amiri", "Noto Naskh Arabic", serif;
        --default-font-family: "Amiri", "Noto Naskh Arabic", serif;
      }
      html, body { font-family: "Amiri", "Noto Naskh Arabic", serif; }
    </style>
  </head>
  <body class="admin-body">
    <% if (typeof adminUser !== "undefined" && adminUser) { %>
    <header class="admin-top">
      <a href="/admin" class="admin-brand">بەڕێوەبەر</a>
      <nav class="admin-nav">
        <a href="/admin">سەرەکی</a>
        <a href="/admin/items">تۆمارەکان</a>
        <a href="/admin/items/new">نوێ</a>
        <a href="/admin/biography">ژیاننامە</a>
        <a href="/" target="_blank" rel="noopener">ماڵپەڕ</a>
      </nav>
      <form method="post" action="/admin/logout" class="admin-logout">
        <input type="hidden" name="_csrf" value="<%= csrf %>" />
        <button type="submit" class="btn btn-sm btn-secondary">دەرچوون</button>
      </form>
    </header>
    <% } %>
    <main class="admin-main">
      <% if (typeof flash !== "undefined" && flash) { %>
      <p class="admin-flash admin-flash--<%= flash.type %>"><%= flash.message %></p>
      <% } %>
      <% if (typeof seedMode !== "undefined" && seedMode && typeof adminUser !== "undefined" && adminUser) { %>
      <p class="admin-flash admin-flash--error">ئێستا لەسەر ناوەڕۆکی ناوخۆیی (seed) دەنووسیت — گۆڕانکارییەکان دوای ڕیستارتی سێرڤەر نامێنن. بۆ بەرهەم CONTENT_SOURCE=firestore دابنێ.</p>
      <% } %>
      <%- body %>
    </main>
  </body>
</html>
