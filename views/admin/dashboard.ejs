<section class="admin-dashboard">
  <%- include("partials/breadcrumb") %>
  <header class="admin-page-header">
    <div>
      <h1 class="t-h2">بەڕێوەبەر</h1>
      <p class="t-body admin-lead">نووسین زیاد بکە، دەستکاری بکە، و بڵاوی بکەوە — گۆڕانکارییەکان ڕاستەوخۆ لە ماڵپەڕدا دەردەکەون.</p>
    </div>
    <a class="btn btn-primary" href="/admin/items/new">+ تۆماری نوێ</a>
  </header>
  <%- include("../partials/gold-rule", { extraClass: "mb-8 max-w-[14rem]" }) %>

  <div class="admin-stat-grid">
    <a class="admin-stat-card float-saucer float-saucer--rounded" href="/admin/items">
      <span class="admin-stat-card__value"><%= kuDigits(counts.all) %></span>
      <span class="admin-stat-card__label">گشتی</span>
    </a>
    <a class="admin-stat-card admin-stat-card--published float-saucer float-saucer--rounded" href="/admin/items?status=published">
      <span class="admin-stat-card__value"><%= kuDigits(counts.published) %></span>
      <span class="admin-stat-card__label">بڵاوکراوە</span>
    </a>
    <a class="admin-stat-card admin-stat-card--draft float-saucer float-saucer--rounded" href="/admin/items?status=draft">
      <span class="admin-stat-card__value"><%= kuDigits(counts.draft) %></span>
      <span class="admin-stat-card__label">ڕەشنووس</span>
    </a>
    <a class="admin-stat-card admin-stat-card--archived float-saucer float-saucer--rounded" href="/admin/items?status=archived">
      <span class="admin-stat-card__value"><%= kuDigits(counts.archived) %></span>
      <span class="admin-stat-card__label">شاردراوەتەوە</span>
    </a>
  </div>

  <div class="admin-quick-actions">
    <a class="admin-quick-action float-saucer float-saucer--rounded" href="/admin/items/new?type=interview">
      <strong>چاوپێکەوتن</strong>
      <span>لینکی یوتیوب · پەڕەی میدیا</span>
    </a>
    <a class="admin-quick-action float-saucer float-saucer--rounded" href="/admin/items/new?type=podcast">
      <strong>پۆدکاست</strong>
      <span>لینکی یوتیوب · پەڕەی میدیا</span>
    </a>
    <a class="admin-quick-action float-saucer float-saucer--rounded" href="/admin/items/new?type=video">
      <strong>ڤیدیۆی ئەرشیف</strong>
      <span>لینکی یوتیوب · پەڕەی میدیا</span>
    </a>
    <a class="admin-quick-action float-saucer float-saucer--rounded" href="/admin/items/new?type=photo">
      <strong>وێنە</strong>
      <span>بارکردن · میدیا / سەرەکی</span>
    </a>
    <a class="admin-quick-action float-saucer float-saucer--rounded" href="/admin/items/new">
      <strong>نووسینی نوێ</strong>
      <span>وتار، لێدوان، بۆچوون...</span>
    </a>
    <a class="admin-quick-action float-saucer float-saucer--rounded" href="/admin/biography">
      <strong>ژیاننامە</strong>
      <span>دەق و وێنەی پەڕەی ژیاننامە</span>
    </a>
  </div>

  <% if (drafts && drafts.length) { %>
  <section class="admin-section admin-section--drafts">
    <div class="admin-section__head">
      <h2 class="t-h3">ڕەشنووسەکان — چاوەڕێی بڵاوکردنەوە</h2>
      <a class="t-meta admin-link" href="/admin/items?status=draft">هەموویان ←</a>
    </div>
    <ul class="admin-draft-list">
      <% drafts.forEach(function (entry) { %>
      <li class="admin-draft-row float-saucer float-saucer--rounded">
        <div class="admin-draft-row__main">
          <a class="admin-draft-row__title" href="/admin/items/<%= entry.id %>"><%= entry.title %></a>
          <p class="t-meta"><%= contentTypeLabels[entry.contentType] %></p>
        </div>
        <div class="admin-draft-row__actions">
          <a class="btn btn-sm btn-light" href="/admin/items/<%= entry.id %>">دەستکاری</a>
          <%- include("partials/status-form", { entry, csrf, status: "published", back: "/admin", label: "بڵاوکردنەوە", buttonClass: "btn-primary" }) %>
          <%- include("partials/status-form", { entry, csrf, status: "archived", back: "/admin", label: "شاردنەوە", buttonClass: "admin-btn-hide", confirm: "دڵنیایت لە شاردنەوەی ئەم تۆمارە لە ماڵپەڕ؟" }) %>
        </div>
      </li>
      <% }); %>
    </ul>
  </section>
  <% } %>

  <% if (archived && archived.length) { %>
  <section class="admin-section admin-section--archived">
    <div class="admin-section__head">
      <h2 class="t-h3">شاردراوەکان</h2>
      <a class="t-meta admin-link" href="/admin/items?status=archived">هەموویان ←</a>
    </div>
    <ul class="admin-draft-list">
      <% archived.forEach(function (entry) { %>
      <li class="admin-draft-row float-saucer float-saucer--rounded">
        <div class="admin-draft-row__main">
          <a class="admin-draft-row__title" href="/admin/items/<%= entry.id %>"><%= entry.title %></a>
          <p class="t-meta"><%= contentTypeLabels[entry.contentType] %> · <%= statusLabels[entry.status] %></p>
        </div>
        <div class="admin-draft-row__actions">
          <a class="btn btn-sm btn-light" href="/admin/items/<%= entry.id %>">دەستکاری</a>
          <%- include("partials/status-form", { entry, csrf, status: "published", back: "/admin", label: "بڵاوکردنەوە", buttonClass: "btn-primary" }) %>
        </div>
      </li>
      <% }); %>
    </ul>
  </section>
  <% } %>

  <section class="admin-section">
    <div class="admin-section__head">
      <h2 class="t-h3">دوایین گۆڕانکاری</h2>
      <a class="t-meta admin-link" href="/admin/items">هەموو تۆمارەکان ←</a>
    </div>
    <% if (!recent.length) { %>
    <div class="admin-empty">
      <p>هێشتا تۆمار نییە.</p>
      <a class="btn btn-primary btn-sm" href="/admin/items/new">یەکەم تۆمار دروست بکە</a>
    </div>
    <% } else { %>
    <ul class="admin-recent-grid">
      <% recent.forEach(function (entry) { %>
      <% const thumb = visualOf(entry); %>
      <% const isBook = entry.contentType === "book" || entry.contentType === "audiobook"; %>
      <li>
        <a class="admin-recent-card float-saucer float-saucer--rounded<%= isBook ? " admin-recent-card--book" : "" %>" href="/admin/items/<%= entry.id %>">
          <div class="admin-recent-card__media">
            <% if (thumb) { %>
            <img src="<%= thumb %>" alt="<%= isBook ? (entry.title || "") : "" %>" loading="lazy" />
            <% } else { %>
            <span class="admin-recent-card__placeholder"><%= contentTypeLabels[entry.contentType].slice(0, 1) %></span>
            <% } %>
          </div>
          <div class="admin-recent-card__body">
            <span class="admin-badge admin-badge--<%= entry.status %>"><%= statusLabels[entry.status] %></span>
            <h3><%= entry.title %></h3>
            <p class="t-meta"><%= contentTypeLabels[entry.contentType] %></p>
          </div>
        </a>
      </li>
      <% }); %>
    </ul>
    <% } %>
  </section>
</section>
