# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Firebase service account keys (never commit)
*firebase-adminsdk*.json
stran-abdullah-*.json
service-account.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local admin uploads (seed mode)
/public/uploads/
!/public/uploads/.gitkeep

# book PDFs for batch upload (large files — keep local)
/data/book-pdfs/*.pdf

# local captures / scratch
/shots/
/person.png
